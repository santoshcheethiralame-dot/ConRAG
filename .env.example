# Copy to .env and fill in. Never commit .env.
# Real Postgres: docker compose up -d   (uses POSTGRES_PASSWORD below)
# No Docker: npm run db:dev   (in-process Postgres + pgvector, any password works)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@localhost:5433/conrag

# 32+ random chars, signs the session cookie
SESSION_SECRET=

# Claim extraction, contradiction judge, answer generation
ANTHROPIC_API_KEY=

# Password for the seeded admin/analyst/viewer demo users
SEED_PASSWORD=

# Optional tuning (defaults shown)
# LLM_PROVIDER=auto              auto | anthropic | offline
# EMBEDDING_PROVIDER=local       local (MiniLM) | hash (no download, lexical only)
# CLAUDE_FAST_MODEL=claude-haiku-5-5
# CLAUDE_ANSWER_MODEL=claude-sonnet-5-5
# RETRIEVAL_K=8
# MIN_SIMILARITY=0.35
# CONFLICT_MIN_SIMILARITY=0.5
# CANDIDATE_MIN_SIMILARITY=0.6
# CANDIDATES_PER_CLAIM=5
