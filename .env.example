# Copy to .env and fill in. Never commit .env.
# Real Postgres: docker compose up -d   (uses POSTGRES_PASSWORD below)
# No Docker: npm run db:dev   (in-process Postgres + pgvector, any password works)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@localhost:5433/conrag

# 32+ random chars, signs the session cookie
SESSION_SECRET=

# Language model for claim extraction, contradiction judging and answers. Optional.
# offline (default): rule-based judge and template answers, no key, no network.
# Free options (get a free key, no card needed): groq (console.groq.com), gemini (aistudio.google.com),
# openrouter (openrouter.ai, ':free' models). Any OpenAI-compatible endpoint also works via LLM_BASE_URL.
LLM_PROVIDER=offline
LLM_API_KEY=

# Password for the seeded admin/analyst/viewer demo users
SEED_PASSWORD=

# Optional tuning (defaults shown)
# EMBEDDING_PROVIDER=local       local (MiniLM) | hash (no download, lexical only)
# LLM_FAST_MODEL=                small model for extraction and judging (provider default if empty)
# LLM_ANSWER_MODEL=              larger model for answers
# LLM_BASE_URL=                  override the provider's endpoint
# LLM_CONCURRENCY=2              parallel model calls at ingest; free tiers rate-limit
# RETRIEVAL_K=8
# MIN_SIMILARITY=0.35
# CONFLICT_MIN_SIMILARITY=0.5
# CANDIDATE_MIN_SIMILARITY=0.6
# CANDIDATES_PER_CLAIM=5
